<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The game itself is fully offline. INTERNET serves exactly
         two things: the local association channel to the wallet app
         (loopback WebSocket, Seeker Connect's MWA link — Gate 0
         C-11: the merged manifest and the resolved artifacts are
         censused to prove no other socket exists) and the shell's
         public-RPC reads for purchase settlement verification. The
         page never gets the network (C-30 network silence). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Backup rules (G-2): the wallet token prefs are excluded from
         cloud backup and device-to-device transfer on every API level
         (dataExtractionRules governs API 31+, fullBackupContent the
         rest); everything else keeps the platform defaults. The MWA
         auth token is a bearer credential that exists to skip the
         wallet approval dialog — it must not ride a backup out of the
         app's own storage choices. -->
    <application
        android:name=".PaperMoonApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.PaperMoon"
        android:hardwareAccelerated="true"
        android:supportsRtl="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
